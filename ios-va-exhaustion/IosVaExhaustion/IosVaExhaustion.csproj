<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-ios26.5</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>true</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <ApplicationId>com.runtime.samples.iosvaexhaustion</ApplicationId>
    <ApplicationTitle>VA Exhaustion</ApplicationTitle>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- The failure is in the NativeAOT segments GC. A Mono or interpreter build will not reproduce it. -->
    <PublishAot>true</PublishAot>
    <UseInterpreter>false</UseInterpreter>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- Opt-in control. The Apple team must already have the Extended Virtual Addressing capability. -->
  <PropertyGroup Condition="'$(ExtendedVirtualAddressing)' == 'true'">
    <CodesignEntitlements>Entitlements.ExtendedVa.plist</CodesignEntitlements>
  </PropertyGroup>
</Project>
